<?xml version="1.0"?>
    <!-- 
============================================================================================================
=                                           output files definition                                        =
=                                            Define your own files                                         =
=                                         put the variables you want...                                    =
============================================================================================================
    -->
    
    <file_definition type="one_file" name="@expname@_@freq@_@startdate@_@enddate@" sync_freq="1d" min_digits="4">
    
      <file_group id="1ts" output_freq="1ts"  output_level="10" enabled=".TRUE."/> <!-- 1 time step files -->
      <file_group id="1h" output_freq="1h"  output_level="10" enabled=".TRUE."/> <!-- 1h files -->
      <file_group id="2h" output_freq="2h"  output_level="10" enabled=".TRUE."/> <!-- 2h files -->
      <file_group id="3h" output_freq="3h"  output_level="10" enabled=".TRUE."/> <!-- 3h files -->     
      <file_group id="4h" output_freq="4h"  output_level="10" enabled=".TRUE."/> <!-- 4h files -->
      <file_group id="6h" output_freq="6h"  output_level="10" enabled=".TRUE."/> <!-- 6h files -->
     
      <file_group id="1d" output_freq="1d"  output_level="10" enabled=".TRUE."/> <!-- 1d files -->

      <file_group id="3d" output_freq="3d"  output_level="10" enabled=".TRUE."/> <!-- 3d files -->    
      <file_group id="20d" output_freq="20d"  output_level="10" enabled=".TRUE."/>  <!-- 20d files -->  


      <file_group id="10d" output_freq="10d" output_level="10" enabled=".TRUE."/> <!-- 10d files -->

      <file_group id="1m" output_freq="1mo" output_level="10" enabled=".TRUE."> <!-- real monthly files -->
        <file id="file1" output_freq="1mo" name_suffix="_grid_T" description="ocean T grid variables" >      
          <field field_ref="toce"         name="votemper"  operation="average" freq_op="1mo" > @toce_e3t / @e3t </field>
          <field field_ref="soce"         name="vosaline"  operation="average" freq_op="1mo" > @soce_e3t / @e3t </field>
          <field field_ref="ssh"          name="sossheig" />
          <!-- variable for ice shelf -->
          <field field_ref="fwfisf_cav"  name="sowflisf"  />
          <field field_ref="ttbl_cav"    name="ttbl"  />
          <field field_ref="stbl"        name="stbl"  />
          <field field_ref="utbl"        name="utbl"  />
          <field field_ref="vtbl"        name="vtbl"  />
        </file>
        <file id="file2" output_freq="1mo" name_suffix="_grid_U" description="ocean U grid variables" >
          <field field_ref="uoce"         name="vozocrtx" operation="average" freq_op="1mo" > @uoce_e3u / @e3u </field>
          <field field_ref="uoce"         name="u_s_flx"  operation="average" freq_op="1mo" > @salt_flx_e3u / @e3u </field>
          <field field_ref="uoce"         name="u_t_flx"  operation="average" freq_op="1mo" > @heat_flx_e3u / @e3u </field>
        </file>
        <file id="file3" output_freq="1mo" name_suffix="_grid_V" description="ocean V grid variables" >
          <field field_ref="voce"         name="vomecrty" operation="average" freq_op="1mo" > @voce_e3v / @e3v </field>
        </file>
        <file id="file4" output_freq="1mo" name_suffix="_grid_W" description="ocean W grid variables" >
          <field field_ref="woce"         name="vovecrtz"     operation="average" freq_op="1mo" > @woce_e3w / @e3w </field>
          <field field_ref="bn2"          name="brun_vais_2"   unit="s-2" />
          <field field_ref="woce"         name="w_s_flx"      operation="average" freq_op="1mo" > @vert_salt_flx_e3w / @e3w </field>
          <field field_ref="woce"         name="w_t_flx"      operation="average" freq_op="1mo" > @vert_heat_flx_e3w / @e3w </field>
          <!-- variable for Dissipation -->
          <field field_ref="woce"         name="vovecrtz_std" operation="average" freq_op="1mo" > sqrt( @woce2_e3w / @e3w - @woce_e3w / @e3w * @woce_e3w / @e3w ) </field>
          <field field_ref="woce"         name="evd_diff"     operation="average" freq_op="1mo" > @avt_evd_e3w / @e3w </field>
        </file>
      </file_group>      
      
      <file_group id="2m" output_freq="2mo" output_level="10" enabled=".TRUE."/> <!-- real 2m files -->
      <file_group id="3m" output_freq="3mo" output_level="10" enabled=".TRUE."/> <!-- real 3m files -->
      <file_group id="4m" output_freq="4mo" output_level="10" enabled=".TRUE."/> <!-- real 4m files -->
      <file_group id="6m" output_freq="6mo" output_level="10" enabled=".TRUE."/> <!-- real 6m files -->
      <file_group id="1y"  output_freq="1y" output_level="10" enabled=".TRUE."> <!-- real yearly files -->

	<file id="file5" output_freq="1y" name_suffix="_grid_T" description="ocean T grid variables" >
	  <field field_ref="toce"         name="votemper"  operation="average" freq_op="1y" > @toce_e3t / @e3t </field>
	  <field field_ref="soce"         name="vosaline"  operation="average" freq_op="1y" > @soce_e3t / @e3t </field>
	  <field field_ref="ssh"          name="sossheig" />
          <!-- variable for ice shelf -->
          <field field_ref="fwfisf_cav"  name="sowflisf"  />
          <field field_ref="ttbl_cav"    name="ttbl"  />
          <field field_ref="stbl"        name="stbl"  />
          <field field_ref="utbl"        name="utbl"  />
          <field field_ref="vtbl"        name="vtbl"  />
        </file>
        <file id="file6" output_freq="1y" name_suffix="_grid_U" description="ocean U grid variables" >
          <field field_ref="uoce"         name="vozocrtx" operation="average" freq_op="1y" > @uoce_e3u / @e3u </field>
          <field field_ref="uoce"         name="u_s_flx"  operation="average" freq_op="1y" > @salt_flx_e3u / @e3u </field>
          <field field_ref="uoce"         name="u_t_flx"  operation="average" freq_op="1y" > @heat_flx_e3u / @e3u </field>
        </file>
        <file id="file7" output_freq="1y" name_suffix="_grid_V" description="ocean V grid variables" >
          <field field_ref="voce"         name="vomecrty" operation="average" freq_op="1y" > @voce_e3v / @e3v </field> 
        </file>
        <file id="file8" output_freq="1y" name_suffix="_grid_W" description="ocean W grid variables" >
          <field field_ref="woce"         name="vovecrtz"     operation="average" freq_op="1y" > @woce_e3w / @e3w </field>
          <field field_ref="woce"         name="w_s_flx"      operation="average" freq_op="1y" > @vert_salt_flx_e3w / @e3w </field>
          <field field_ref="woce"         name="w_t_flx"      operation="average" freq_op="1y" > @vert_heat_flx_e3w / @e3w </field>
          <field field_ref="bn2"          name="brun_vais_2"   unit="s-2" />
          <!-- variable for Dissipation -->
          <field field_ref="woce"         name="vovecrtz_std" operation="average" freq_op="1y" > sqrt( @woce2_e3w / @e3w - @woce_e3w / @e3w * @woce_e3w / @e3w ) </field>
          <field field_ref="woce"         name="evd_diff"     operation="average" freq_op="1y" > @avt_evd_e3w / @e3w </field>
        </file>
      </file_group>

      <file_group id="2y"  output_freq="2y" output_level="10" enabled=".TRUE."/> <!-- real 2y files -->
      <file_group id="5y"  output_freq="5y" output_level="10" enabled=".TRUE."/> <!-- real 5y files -->
      <file_group id="10y" output_freq="10y" output_level="10" enabled=".TRUE."/> <!-- real 10y files -->

   </file_definition>

